# VOATZ BACKEND — Environment Variables Template
# Copy: cp .env.example .env  then fill in your real values
# NEVER commit the actual .env file

SECRET_KEY=<run: openssl rand -hex 32>
JWT_SECRET_KEY=<run: openssl rand -hex 32>
DATABASE_URL=postgresql://flask_user:your_password@localhost:5432/voatz
JWT_EXPIRY_HOURS=2
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
FORCE_HTTPS=false
FLASK_ENV=development
FLASK_DEBUG=false
